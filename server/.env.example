# Copy to server/.env and fill in. server/.env is git-ignored: never commit it.

# PostgreSQL connection. Create the database first, e.g. with: createdb -U postgres sentinel
# Characters like / @ : # in the password must be percent-encoded (/ is %2F).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sentinel?schema=public"

# Optional: the database the API tests use. By default it is DATABASE_URL with "_test"
# added to the name (e.g. sentinel_test). Tests empty its tables, so it must end in _test.
# TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sentinel_test?schema=public"

# HTTP port for the API.
PORT=4000

# The first admin account, created by `npm run db:seed -w @sentinel/server`.
# The password must be at least 12 characters. Change it after the first login.
SEED_ADMIN_NAME="Sentinel Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
